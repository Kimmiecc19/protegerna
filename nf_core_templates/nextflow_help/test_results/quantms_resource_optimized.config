process {
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:PRELIMINARY_ANALYSIS' {
        cpus   = 6
        memory = 38.GB
        time = { 8.hour * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }

    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:INSILICO_LIBRARY_GENERATION' {
        cpus   = 10
        memory = 28.GB
        time = { 2.hour * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:SUMMARY_PIPELINE' {
        cpus   = 2
        memory = 12.GB
        time = { 37.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:MSSTATS_LFQ' {
        cpus   = 2
        memory = 4.GB
        time = { 19.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:FILE_PREPARATION:MZML_STATISTICS' {
        cpus   = 2
        memory = 18.GB
        time = { 20.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:FILE_PREPARATION:MZML_INDEXING' {
        cpus   = 1
        memory = 18.GB
        time = { 14.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:FINAL_QUANTIFICATION' {
        cpus   = 2
        memory = 5.GB
        time = { 10.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:INDIVIDUAL_ANALYSIS' {
        cpus   = 6
        memory = 10.GB
        time = { 10.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:CONVERT_RESULTS' {
        cpus   = 2
        memory = 3.GB
        time = { 10.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:ASSEMBLE_EMPIRICAL_LIBRARY' {
        cpus   = 2
        memory = 16.GB
        time = { 10.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:INPUT_CHECK:SAMPLESHEET_CHECK' {
        cpus   = 1
        memory = 1.GB
        time = { 10.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:GENERATE_CFG' {
        cpus   = 1
        memory = 1.GB
        time = { 10.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:CREATE_INPUT_CHANNEL:PREPROCESS_EXPDESIGN' {
        cpus   = 2
        memory = 1.GB
        time = { 10.min * task.attempt }
        errorStrategy = { task.exitStatus in 137..140 ? 'retry' : 'terminate' }
        maxRetries = 3
    }
}
