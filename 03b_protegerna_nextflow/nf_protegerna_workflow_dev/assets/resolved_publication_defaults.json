  "merge": {
    "recursive": false,
    "record_types": [
      "protein"
    ],
    "out_fasta": "proteogenomic_database.fasta",
    "out_metadata": "proteogenomic_metadata.tsv",
    "out_mapping": "proteogenomic_mapping.tsv",
    "out_peptide_evidence": "proteogenomic_peptides.tsv",
    "out_biological_interpretation": "proteogenomic_biological.tsv",
    "out_summary_tsv": "proteogenomic_summary.tsv",
    "out_summary_json": "proteogenomic_summary.json",
    "id_prefix": "PGDB_U",
    "id_width": 7,
    "max_header_values": 3,
    "min_protein_length": 6,
