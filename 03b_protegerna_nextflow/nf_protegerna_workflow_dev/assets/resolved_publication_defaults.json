    "workers": 4,
    "nmd_distance_threshold_nt": 55,
    "exclude_frameshift_from_dia": false,
    "exclude_nmd_from_dia": true,
    "exclude_start_loss_from_dia": true,
    "exclude_premature_stop_from_dia": false,
    "exclude_incomplete_cds": true,
    "require_ri_orf_preserved": true,
