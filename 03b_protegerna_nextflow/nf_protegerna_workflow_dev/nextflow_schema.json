            "type": "string",
            "minLength": 1
        },
        "gencode_protein_fasta": {
            "type": "string",
            "minLength": 1
        },
        "annotation_release": {
            "type": "string",
            "minLength": 1
        },
        "organism": {
            "type": "string",
            "minLength": 1
        },
        "proteogenomic_container": {
            "type": "string",
            "minLength": 1
        },
        "runtime_source": {
            "type": "string",
            "minLength": 1
        },
        "gtf": {
            "type": [
                "string",
                "null"
            ],
            "description": "Optional input file; gtf and gtf_db are mutually exclusive."
        },
        "gtf_db": {
            "type": [
                "string",
                "null"
            ],
            "description": "Optional input file; gtf and gtf_db are mutually exclusive."
        },
        "contaminants": {
            "type": [
                "string",
                "null"
            ],
            "description": "Optional input file; gtf and gtf_db are mutually exclusive."
        },
        "sample_metadata": {
            "type": [
                "string",
                "null"
            ],
            "description": "Optional input file; gtf and gtf_db are mutually exclusive."
        },
        "reference_peptide_cache": {
            "type": [
                "string",
                "null"
            ],
            "description": "Optional input file; gtf and gtf_db are mutually exclusive."
        },
        "max_cpus": {
            "type": "integer",
            "default": 8
        },
        "max_memory": {
            "type": "string",
            "default": "32.GB"
        },
        "min_peptide_length": {
            "type": "integer",
            "default": 7
        },
        "max_peptide_length": {
            "type": "integer",
            "default": 40
        },
        "max_missed_cleavages": {
            "type": "integer",
            "default": 3
        },
        "suppa_require_psi": {
            "type": "boolean",
            "default": true
        },
        "validate": {
            "type": "object",
            "additionalProperties": false,
            "description": "validate options. Omitted keys use the frozen publication value in assets/resolved_publication_defaults.json; unknown keys stop the run.",
            "properties": {
                "out_tsv": {
                    "type": "string",
                    "default": "gencode_translation_concordance.tsv"
                },
                "out_summary_json": {
                    "type": "string",
                    "default": "gencode_translation_concordance.json"
                },
                "max_mismatch_rate": {
                    "type": "number",
                    "default": 0.0
                }
            },
            "default": {}
        },
        "fusion": {
            "type": "object",
            "additionalProperties": false,
            "description": "fusion options. Omitted keys use the frozen publication value in assets/resolved_publication_defaults.json; unknown keys stop the run.",
            "properties": {
                "recursive_inputs": {
                    "type": "boolean",
                    "default": false
                },
                "biological_interpretation_tsv": {
                    "type": "string",
                    "default": "fusion.biological.tsv"
                },
                "filtered_cds_fasta": {
                    "type": "string",
                    "default": "fusion.primary.cds.fasta"
                },
                "filtered_protein_fasta": {
                    "type": "string",
                    "default": "fusion.primary.fasta"
                },
                "dia_database_metadata_tsv": {
                    "type": "string",
                    "default": "fusion.metadata.tsv"
                },
                "out_sequence_sample_tsv": {
                    "type": "string",
                    "default": "fusion.sequence_samples.tsv"
                },
                "digested_peptide_tsv": {
                    "type": "string",
                    "default": "fusion.peptides.tsv"
                },
                "nmd_distance_threshold_nt": {
                    "type": "integer",
                    "default": 55
                },
                "early_stop_aa_cutoff": {
                    "type": "integer",
                    "default": 30
                },
                "workers": {
                    "type": "integer",
                    "default": 4
                },
                "max_transcripts_per_gene": {
                    "type": "integer",
                    "default": 3
                },
                "digest_trypsin": {
                    "type": "boolean",
                    "default": true
                },
                "min_protein_length": {
                    "type": "integer",
                    "default": 30
                },
                "quantms_conservative": {
                    "type": "boolean",
                    "default": true
                },
                "exclude_incomplete_cds": {
                    "type": "boolean",
                    "default": true
                },
                "require_unique_junction_peptide": {
                    "type": "boolean",
                    "default": true
                },
                "require_junction_peptide": {
                    "type": "boolean",
                    "default": true
                },
                "exclude_frameshift_from_dia": {
                    "type": "boolean",
                    "default": true
                },
                "exclude_truncated_from_dia": {
                    "type": "boolean",
                    "default": true
                },
                "exclude_nmd_from_dia": {
                    "type": "boolean",
                    "default": true
                },
                "include_donor_only_products": {
                    "type": "boolean",
                    "default": false
                },
                "min_retained_cds_nt": {
                    "type": "integer",
                    "default": 30
                },
                "max_breakpoint_snap_distance_nt": {
                    "type": "integer",
                    "default": 25
                },
                "min_split_reads_for_snapped_product": {
                    "type": "integer",
                    "default": 2
                },
                "max_missed_cleavages": {
                    "type": "integer",
                    "default": 3
                },
                "digested_min_peptide_length": {
                    "type": "integer",
                    "default": 7
                },
                "digested_max_peptide_length": {
                    "type": "integer",
                    "default": 40
                }
            },
            "default": {}
        },
        "rmats": {
            "type": "object",
            "additionalProperties": false,
            "description": "rmats options. Omitted keys use the frozen publication value in assets/resolved_publication_defaults.json; unknown keys stop the run.",
            "properties": {
                "out_prot_fa": {
                    "type": "string",
                    "default": "rmats.primary.fasta"
                },
                "out_alt_start_prot_fa": {
                    "type": "string",
                    "default": "rmats.alternative_start.fasta"
                },
                "out_exploratory_orf_fa": {
                    "type": "string",
                    "default": "rmats.exploratory_orf.fasta"
                },
                "out_junc_fa": {
                    "type": "string",
                    "default": "rmats.junctions.fasta"
                },
                "out_consequence_tsv": {
                    "type": "string",
                    "default": "rmats.consequences.tsv"
                },
                "out_event_summary_tsv": {
                    "type": "string",
                    "default": "rmats.events.tsv"
                },
                "max_fdr": {
                    "type": "number",
                    "default": 1.0
                },
                "min_abs_inc_level_difference": {
                    "type": "number",
                    "default": 0.0
                },
                "min_inclusion_junction_reads": {
                    "type": "integer",
                    "default": 0
                },
                "min_skipping_junction_reads": {
                    "type": "integer",
                    "default": 0
                },
