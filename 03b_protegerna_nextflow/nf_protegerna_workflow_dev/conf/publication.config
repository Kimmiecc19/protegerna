/*
 * -profile publication : the main production profile.
 *
 * Usage:
 *   nextflow run . -profile publication -params-file params.yml -resume
 *
 * Copy assets/params.publication.yml, set the paths and change any option. Every
 * pipeline parameter and every stage option (validate/fusion/rmats/suppa/merge/qc)
 * can be set there; options you delete fall back to the frozen publication values in
 * assets/resolved_publication_defaults.json.
 *
 * This file sets only compute resources. Requests are capped by max_cpus/max_memory.
 * Per-process changes can be added with -c custom.config, e.g.
 *   process { withName: 'FUSIONINSPECTOR_TO_PROTEIN' { cpus = 8; memory = '48.GB' } }
 */
process {
    withLabel: process_medium { cpus = 2; memory = '8.GB' }
    withLabel: process_high   { cpus = 4; memory = '16.GB' }
}
