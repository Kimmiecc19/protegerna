{
  "options": {
    "recursive": false,
    "record_types": [
      "protein"
    ],
    "out_fasta": "proteogenomic_database.fasta",
    "out_metadata": "proteogenomic_metadata.tsv",
    "out_mapping": "proteogenomic_mapping.tsv",
    "out_peptide_evidence": "proteogenomic_peptides.tsv",
    "out_biological_interpretation": "proteogenomic_biological.tsv",
    "out_summary_tsv": "proteogenomic_summary.tsv",
    "out_summary_json": "proteogenomic_summary.json",
    "id_prefix": "PGDB_U",
    "id_width": 7,
    "max_header_values": 3,
    "min_protein_length": 6,
    "max_protein_length": null,
    "min_peptide_length": 7,
    "max_peptide_length": 40,
    "max_missed_cleavages": 3,
    "include_rescue_tiers": false,
    "invalid_sequence_policy": "error",
    "log_level": "INFO",
    "annotation_release": "GENCODE_46",
    "organism": "Homo_sapiens"
  },
  "inputs": {
    "inputs": [
      "variants/producer0001/fusion.primary.fasta",
      "variants/producer0002/rmats.primary.fasta",
      "variants/producer0003/suppa.primary.fasta"
    ],
    "reference_fasta": [
      "references/proteome.fa"
    ],
    "contaminants_fasta": [],
    "gencode_concordance_summary": "gencode_translation_concordance.json"
  },
  "process": "PROTEGERNA:MERGE_PROTEOGENOMIC_DATABASE",
  "cpus": 4
}
