{
    "igenomes_ignore": true,
    "step": "prepare_recalibration",
    "aligner": "bwa-mem2",
    "tools": "cnvkit,manta,tiddit,merge",
    "concatenate_vcfs": true,
    "nucleotides_per_second": 1000000,
    "known_snps": "/path/to/references/Homo_sapiens_assembly38.dbsnp138.vcf.gz",
