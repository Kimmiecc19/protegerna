    "snpeff_db": "GRCh38.105",
    "snpeff_genome": "GRCh38",
    "snpeff_cache": "/path/to/references/snpeff_cache",
    "vep_genome": "GRCh38",
    "vep_species": "homo_sapiens",
    "vep_cache_version": "112", 
    "vep_cache": "/path/to/references/vep_cache",
    "vep_dbnsfp": true, 
