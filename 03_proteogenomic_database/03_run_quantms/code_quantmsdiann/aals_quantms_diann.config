// quantms Configuration

// Enable Apptainer
apptainer {
    enabled = true
    autoMounts = true
    // Set cache directory for pre-downloaded images
    cacheDir = '/home/kcoetzer/nf/nf_images/quantms_images/'
}

process {
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:PRELIMINARY_ANALYSIS' {
        cpus   = 6
        memory = 38.GB
        time = { 10.hour * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:INSILICO_LIBRARY_GENERATION' {
        cpus   = 10
        memory = 31.GB
        time = { 2.hour * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:SUMMARY_PIPELINE' {
        cpus   = 2
        memory = 8.GB
        time = { 33.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:FILE_PREPARATION:MZML_STATISTICS' {
        cpus   = 2
        memory = 19.GB
        time = { 30.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:LFQ:ID:PEPTIDE_DATABASE_SEARCH:COMET' {
        cpus   = 7
        memory = 9.GB
        time = { 19.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:MSSTATS_LFQ' {
        cpus   = 2
        memory = 3.GB
        time = { 19.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:FILE_PREPARATION:MZML_INDEXING' {
        cpus   = 1
        memory = 18.GB
        time = { 23.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:INDIVIDUAL_ANALYSIS' {
        cpus   = 5
        memory = 10.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:FINAL_QUANTIFICATION' {
        cpus   = 2
        memory = 4.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:ASSEMBLE_EMPIRICAL_LIBRARY' {
        cpus   = 2
        memory = 18.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:CONVERT_RESULTS' {
        cpus   = 2
        memory = 2.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:DIA:GENERATE_CFG' {
        cpus   = 1
        memory = 1.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:LFQ:ID:PSM_RESCORING:PERCOLATOR' {
        cpus   = 1
        memory = 1.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:INPUT_CHECK:SAMPLESHEET_CHECK' {
        cpus   = 2
        memory = 1.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
    withName: 'BIGBIO_QUANTMS:QUANTMS:CREATE_INPUT_CHANNEL:PREPROCESS_EXPDESIGN' {
        cpus   = 2
        memory = 1.GB
        time = { 10.min * task.attempt }
        errorStrategy = 'retry'
        maxRetries = 3
    }
}
