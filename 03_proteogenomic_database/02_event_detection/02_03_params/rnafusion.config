// rnafusion Config profile

params {
    fasta = '/path/to/references/GRCh38/gencode_v46/gencode/Homo_sapiens_GRCh38_46_dna_primary_assembly.fa'
    fai = '/path/to/references/GRCh38/gencode_v46/gencode/Homo_sapiens_GRCh38_46_dna_primary_assembly.fa.fai'
    gtf = '/path/to/references/GRCh38/gencode_v46/gencode/Homo_sapiens_GRCh38_46.gtf'
}

apptainer {
    enabled = true
    autoMounts = true
    cacheDir = '/path/to/apptainer_cache/rnafusion_images/'
}

process {
    withName: 'RNAFUSION:FUSIONCATCHER_WORKFLOW:FUSIONCATCHER_FUSIONCATCHER' {
        cpus   = 3
        memory = 25.GB
        time   = '7h'
    }
    withName: 'RNAFUSION:QC_WORKFLOW:PICARD_COLLECTRNASEQMETRICS' {
        cpus   = 1
        memory = 7.GB
        time   = '3h'
    }
    withName: 'RNAFUSION:FUSIONINSPECTOR_WORKFLOW:FUSIONINSPECTOR' {
        cpus   = 3
        memory = 49.GB
        time   = '6h' //Adjusted because 2h was not enough
    }
    withName: 'RNAFUSION:SALMON_QUANT' {
        cpus   = 4
        memory = 25.GB
        time   = '2h'
    }
    withName: 'RNAFUSION:FUSIONINSPECTOR_WORKFLOW:ARRIBA_VISUALISATION' {
        cpus   = 2
        memory = 4.GB
        time   = '90min' //Adjusted from calculated 49m.
    }
    withName: 'RNAFUSION:CTATSPLICING_STARTOCANCERINTRONS' {
        cpus   = 1
        memory = 4.GB
        time   = '52m'
    }
    withName: 'RNAFUSION:QC_WORKFLOW:GATK4_MARKDUPLICATES' {
        cpus   = 2
        memory = 12.GB
        time   = '54m'
    }
    withName: 'RNAFUSION:FASTQ_ALIGN_STAR:STAR_ALIGN' {
        cpus   = 6
        memory = 39.GB
        time   = '53m'
    }
    withName: 'RNAFUSION:STARFUSION_DETECT' {
        cpus   = 6
        memory = 10.GB
        time   = '36m'
    }
    withName: 'RNAFUSION:FASTQ_FASTQC_UMITOOLS_FASTP:FASTQC_TRIM' {
        cpus   = 2
        memory = 9.GB
        time   = '27m'
    }
    withName: 'RNAFUSION:BAM_STRINGTIE_MERGE:STRINGTIE_STRINGTIE' {
        cpus   = 2
        memory = 2.GB
        time   = '21m'
    }
    withName: 'RNAFUSION:FASTQ_FASTQC_UMITOOLS_FASTP:FASTQC_RAW' {
        cpus   = 2
        memory = 9.GB
        time   = '17m'
    }
    withName: 'RNAFUSION:ARRIBA_ARRIBA' {
        cpus   = 1
        memory = 10.GB
        time   = '17m'
    }
    withName: 'RNAFUSION:FASTQ_ALIGN_STAR:BAM_SORT_STATS_SAMTOOLS_GENOME:SAMTOOLS_SORT' {
        cpus   = 2
        memory = 7.GB
        time   = '14m'
    }
    withName: 'RNAFUSION:QC_WORKFLOW:PICARD_COLLECTINSERTSIZEMETRICS' {
        cpus   = 1
        memory = 2.GB
        time   = '13m'
    }
    withName: 'RNAFUSION:FASTQ_FASTQC_UMITOOLS_FASTP:FASTP' {
        cpus   = 5
        memory = 2.GB
        time   = '11m'
    }
    withName: 'RNAFUSION:SAMTOOLS_INDEX' {
        cpus   = 2
        memory = 1.GB
        time   = '10m'
    }
    withName: 'RNAFUSION:BAM_STRINGTIE_MERGE:STRINGTIE_MERGE' {
        cpus   = 2
        memory = 1.GB
        time   = '10m'
    }
    withName: 'RNAFUSION:FUSIONREPORT_DETECT' {
        cpus   = 1
        memory = 1.GB
        time   = '10m'
    }
    withName: 'RNAFUSION:FUSIONINSPECTOR_WORKFLOW:AGAT_CONVERTSPGFF2TSV' {
        cpus   = 2
        memory = 1.GB
        time   = '10m'
    }
    withName: 'RNAFUSION:FUSIONINSPECTOR_WORKFLOW:VCF_COLLECT' {
        cpus   = 2
        memory = 1.GB
        time   = '10m'
    }
}
